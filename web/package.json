{
  "name": "@theinfinity/web",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/generate-tokens.mjs",
    "dev": "node scripts/generate-tokens.mjs && astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "node scripts/generate-tokens.mjs && astro check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "perf": "node scripts/perf-budget.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "check:citations": "node scripts/check-citations.mjs",
    "validate:openapi": "npx --yes @redocly/cli lint ../docs/openapi.yaml"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.1.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
