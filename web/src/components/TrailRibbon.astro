---
// The thread, on the concept page. Beads joined by a violet wire; the current
// node is violet and bold. Collapses to tier dots on mobile.
import type { ResolvedNode } from '../lib/graph';
import TierDot from './TierDot.astro';
interface Props { stops: ResolvedNode[]; currentId: string }
const { stops, currentId } = Astro.props;
---
<nav
  aria-label="Your thread"
  class="flex flex-wrap items-center gap-y-2.5 border-t border-line bg-nebula-2 px-[26px] py-4"
>
  <span class="mr-4 font-mono text-[10px] uppercase tracking-[.16em] text-dust">Your thread</span>
  {
    stops.map((stop, i) => (
      <span class="flex items-center">
        <a
          href={`/c/${stop.id}`}
          class:list={[
            'whitespace-nowrap text-[13px] no-underline max-md:hidden',
            stop.id === currentId ? 'font-bold text-thread' : 'text-starlight',
          ]}
        >
          {stop.title}
        </a>
        <span class="md:hidden"><TierDot tier={stop.tier} size={9} /></span>
        {i < stops.length - 1 && <span class="mx-2 h-px w-[26px] bg-thread opacity-50" />}
      </span>
    ))
  }
  <button
    type="button"
    class="ml-auto cursor-pointer rounded-row border border-thread bg-transparent px-[18px] py-[9px] text-[14px] font-medium text-thread max-md:mt-2.5 max-md:w-full max-md:bg-thread max-md:font-bold max-md:text-void"
  >
    Share trail
  </button>
</nav>
