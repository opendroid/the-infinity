---
// Inside the island, violet is the DATA channel. Tier colours never appear
// here — a bar is not a trust signal.
//
// This dispatches on `viz.primitive` to the component that implements it, and
// falls back to a generic placeholder for the primitives that have not landed
// yet. That fallback is load-bearing, not politeness: the schema's enum names
// four primitives and only some are built (content/schema/README.md), so a
// dispatch without one would blank the island for any node using the others.
// The enum keeps typos out; the fallback keeps honest names from rendering
// nothing.
//
// IMPLEMENTED is written out rather than inferred so the fallback is a
// deliberate list instead of an `else`. Shipping a primitive means adding its
// name here — and forgetting to is a visible placeholder, not a blank box.
import type { ResolvedNode } from '../lib/graph';
import RouterDispatch from './viz/RouterDispatch';
import UpdateSpectrum from './viz/UpdateSpectrum';
import BudgetSplit from './viz/BudgetSplit';

interface Props { node: ResolvedNode }
const { node } = Astro.props;
const { viz } = node;

const IMPLEMENTED = new Set(['router-dispatch', 'update-spectrum', 'budget-split']);

const shared = {
  seed: node.id,
  params: viz.params,
  control: viz.param_controls[0],
  caption: viz.caption,
  captionEngineer: viz.caption_engineer,
};

const params = Object.entries(viz.params)
  .map(([k, v]) => `${k} = ${v}`)
  .join(' · ');
// Deterministic pseudo-bars: a placeholder shape, not a real simulation. The
// remaining primitives land as their own issues.
const bars = Array.from({ length: 8 }, (_, i) => 30 + ((i * 37) % 70));
---

{viz.primitive === 'router-dispatch' && <RouterDispatch client:load {...shared} />}
{viz.primitive === 'update-spectrum' && <UpdateSpectrum client:load {...shared} />}
{viz.primitive === 'budget-split' && <BudgetSplit client:load {...shared} />}

{
  !IMPLEMENTED.has(viz.primitive) && (
    <figure class="rounded-island border border-line bg-void p-[22px]">
      <figcaption class="mb-3.5 flex flex-wrap justify-between gap-1.5 font-mono text-[10px] uppercase tracking-[.16em] text-dust">
        <span>Viz primitive · {viz.primitive}</span>
        <span>{params}</span>
      </figcaption>
      <div class="flex h-[104px] items-end gap-1.5" aria-hidden="true">
        {
          bars.map((h, i) => (
            <div
              class="flex-1 rounded-[2px]"
              style={`height:${h}%;background:${i % 3 === 0 ? 'var(--color-thread)' : 'color-mix(in srgb, var(--color-thread) 45%, transparent)'}`}
            />
          ))
        }
      </div>
      {/*
        Says what it is. The caption below describes the picture this primitive
        WILL draw, and until it is built the shape above is not that picture —
        so without this line the page reads as a caption describing marks that
        are not on screen, which is the defect #97 and #94 were opened for.
      */}
      <p class="mt-2.5 font-mono text-[10px] uppercase tracking-[.12em] text-dust">
        Placeholder — the {viz.primitive} primitive is not built yet
      </p>
      <p class="mt-2 max-w-[58ch] text-[12.5px] text-dust">{viz.caption}</p>
      {
        shared.control && (
          <p class="mt-2 font-mono text-[10px] uppercase tracking-[.14em] text-dust">
            Draggable: {shared.control.name} ({shared.control.min}–{shared.control.max})
          </p>
        )
      }
    </figure>
  )
}
