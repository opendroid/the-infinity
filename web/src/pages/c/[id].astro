---
// Route 2 — Concept page. The product. ~95% of traffic arrives here from search,
// so it pre-renders complete: all three depth bodies, every edge, the mini-map's
// first paint. Nothing below waits on the API to be readable.
import Base from '../../layouts/Base.astro';
import Topbar from '../../components/Topbar.astro';
import Eyebrow from '../../components/Eyebrow.astro';
import TierBadge from '../../components/TierBadge.astro';
import EdgeGroup from '../../components/EdgeGroup.astro';
import MiniMap from '../../components/MiniMap';
import VizIsland from '../../components/VizIsland.astro';
import TrailRibbon from '../../components/TrailRibbon';
import DepthToggle from '../../components/DepthToggle';
import ReviewActions from '../../components/ReviewActions';
import { allNodes, graph, nodeOrThrow } from '../../lib/content';
import { neighborhood, splitEmphasis, type Depth } from '../../lib/graph';
import { segments, withoutMarkers } from '../../lib/refs';

export function getStaticPaths() {
  return allNodes.map((node) => ({ params: { id: node.id } }));
}

const { id } = Astro.params;
const node = nodeOrThrow(id!);
const map = neighborhood(graph, node.id);

const DEPTHS: Depth[] = ['intuition', 'engineer', 'math'];
// A backticked id in body copy becomes a link (#298). Resolved here rather than
// in the island so the payload carries the handful of references a node actually
// has, not the whole corpus's id list.
const titleOf = new Map(allNodes.map((n) => [n.id, n.title]));
const resolve = (id: string) => titleOf.get(id) ?? null;

const bodies = DEPTHS.map((depth) => {
  const [before, emphasis, after] = splitEmphasis(node.bodies[depth], node.emphasis?.[depth]);
  return {
    depth,
    before: segments(before, resolve),
    emphasis: segments(emphasis, resolve),
    after: segments(after, resolve),
  };
});

---

<Base
  title={`${node.title} — theinfinity.ai`}
  description={withoutMarkers(node.bodies.intuition).slice(0, 155)}
  type="article"
>
  <Topbar />

  {/*
    The depth scope (ADR-0005). `DepthToggle` writes `data-depth` here and the
    viz island's CSS reads it, so the two stay in step without either one
    holding a reference to the other. It wraps both, which is the only thing it
    has to do.
  */}
  <div data-depth-scope class="grid grid-cols-[1fr_288px] max-[760px]:grid-cols-1">
    <main class="min-w-0 px-[30px] pb-[30px] pt-[34px]">
      <div class="flex flex-wrap items-center gap-3">
        <Eyebrow>{node.domain.join(' / ')}</Eyebrow>
        <TierBadge tier={node.tier} />
      </div>

      <h1 class="my-4 font-display text-[32px] font-semibold leading-[1.16] max-md:text-[23px] max-md:leading-[1.2]">
        {node.title}
      </h1>

      <DepthToggle client:load bodies={bodies} initial="intuition" />

      <div class="mt-6">
        <VizIsland node={node} />
      </div>

      {
        node.tier === 'frontier' && node.provenance && (
          <section class="mt-6 rounded-island border border-line bg-raised-wash px-5 py-[18px]">
            <Eyebrow>Provenance · frontier node</Eyebrow>
            <p class="mt-2 max-w-[62ch] text-[14px] text-dust">
              Drafted {node.provenance.drafted_at} and awaiting human review. The sources below are
              what it was written from.
            </p>
            <ul class="mt-3 space-y-1.5">
              {node.citations.map((c) => (
                <li class="font-mono text-[11.5px] text-dust">
                  <a href={c.url} class="text-thread no-underline hover:underline">{c.ref}</a> — {c.title}
                </li>
              ))}
            </ul>
            {node.origin && node.origin.length > 0 && (
              <>
                {/*
                  ADR-0013. Rendered as TEXT, never as links, and under a label of
                  its own — these are sources nothing fetched. Presenting an
                  asserted attribution in the same violet as a checked one would
                  tell the reader the two carry the same weight, which is the
                  single outcome that ADR exists to prevent.
                */}
                <p class="mt-4 font-mono text-[10px] uppercase tracking-[.16em] text-dust">
                  Origin · not linkable
                </p>
                <ul class="mt-2 space-y-1.5">
                  {node.origin.map((o) => (
                    <li class="font-mono text-[11.5px] text-dust">
                      {o.ref} — {o.title}
                      {o.venue && <span> · {o.venue}</span>}
                      {o.doi && <span> · doi:{o.doi}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
            {/*
              client:idle, not client:visible. The island renders null until it
              mounts (no JS, no buttons), so a visible-gated island has zero
              height, never becomes visible, and never hydrates — the controls
              simply never appear. Found by clicking them in a browser.
            */}
            <ReviewActions client:idle conceptId={node.id} />
          </section>
        )
      }

      {
        node.tier === 'verified' && node.review && (
          <section class="mt-6">
            <Eyebrow>
              Reviewed by {node.review.reviewed_by} · {node.review.reviewed_at}
            </Eyebrow>
            <ul class="mt-3 space-y-1.5">
              {node.citations.map((c) => (
                <li class="font-mono text-[11.5px] text-dust">
                  <a href={c.url} class="text-thread no-underline hover:underline">{c.ref}</a> — {c.title}
                </li>
              ))}
            </ul>
            {node.origin && node.origin.length > 0 && (
              <>
                {/*
                  ADR-0013. Rendered as TEXT, never as links, and under a label of
                  its own — these are sources nothing fetched. Presenting an
                  asserted attribution in the same violet as a checked one would
                  tell the reader the two carry the same weight, which is the
                  single outcome that ADR exists to prevent.
                */}
                <p class="mt-4 font-mono text-[10px] uppercase tracking-[.16em] text-dust">
                  Origin · not linkable
                </p>
                <ul class="mt-2 space-y-1.5">
                  {node.origin.map((o) => (
                    <li class="font-mono text-[11.5px] text-dust">
                      {o.ref} — {o.title}
                      {o.venue && <span> · {o.venue}</span>}
                      {o.doi && <span> · doi:{o.doi}</span>}
                    </li>
                  ))}
                </ul>
              </>
            )}
          </section>
        )
      }
    </main>

    <aside class="border-l border-line bg-panel-wash px-6 py-[30px] max-[760px]:border-l-0 max-[760px]:border-t">
      <EdgeGroup type="requires" edges={node.edges.requires} from={`/c/${node.id}`} />
      <EdgeGroup type="unlocks" edges={node.edges.unlocks} from={`/c/${node.id}`} />
      <EdgeGroup type="adjacent" edges={node.edges.adjacent} from={`/c/${node.id}`} />
      <MiniMap id={node.id} initial={map} client:idle />
    </aside>
  </div>

  {/*
    client:load, not idle. This island renders the ribbon itself, so deferring
    it defers content — and it is what records the visit, which must happen on
    arrival rather than whenever the browser gets round to it. Astro renders it
    to HTML at build time, so the no-JavaScript reader still gets a ribbon
    showing this node: the true trail for a browser that cannot remember one.
  */}
  <TrailRibbon client:load id={node.id} title={node.title} tier={node.tier} />
</Base>
