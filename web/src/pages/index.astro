---
// Route 1 — Universe. Job: orient and invite; get the visitor onto a node in
// under ten seconds. No nav bar, no CTA beyond search. The search field is the
// one glowing element on this screen.
import Base from '../layouts/Base.astro';
import Thread from '../components/Thread.astro';
import { allNodes, stats } from '../lib/content';
import { DEPTHS, hrefFor } from '../lib/depth';
import { placeLayout, readLayout } from '../lib/layout';

const { concepts, grewThisWeek, frontier: awaitingReview } = stats();

// WHICH concepts sit on the thread is a committed decision, not a slice of the
// alphabet: /content/layout/lemniscate.json, per ADR-0003. That file also says
// how a node earns a place. WHERE each one sits comes from the curve module, so
// a bead cannot drift off the stroke (#52).
//
// Verified takes the left lobe and frontier the right, so the figure reads as
// "reviewed core → new growth". `validate:content` fails the PR if a bead names
// a concept that does not exist, or one whose tier belongs to the other lobe.
const layout = placeLayout(readLayout(), allNodes);

const bead = (b: (typeof layout.left)[number]) => ({
  tier: b.tier,
  at: b.t,
  ...(b.label ? { label: b.title } : {}),
});

const verified = layout.left.map(bead);
const frontier = layout.right.map(bead);
const chips = layout.chips;

// THE FIRST CHIP, NOT A NAME WRITTEN HERE (#508). Which concepts sit on the
// thread is already a committed decision in lemniscate.json, and
// `validate:content` fails the PR if a chip names a concept that does not
// exist. Hard-coding `attention` here would be a second answer to a question
// that file already answers, free to disagree with it after a layout change.
// `chips[0]` is `T | undefined` under `noUncheckedIndexedAccess`, and that is a
// fair question rather than a nuisance: nothing forces lemniscate.json to carry
// chips. So the line renders only when there is a concept to name, and a layout
// without chips loses a sentence instead of failing a build.
const sample = chips[0];
const LABEL: Record<(typeof DEPTHS)[number], string> = {
  intuition: 'Intuition',
  engineer: 'Engineer',
  math: 'Math',
};
---

<Base
  title="theinfinity.ai — an explorable concept graph for AI"
  description="An explorable concept graph for AI/ML. Each concept has a 30-second intuition, an engineer's view, and the maths, with typed edges to what comes next."
>
  <main class="hero-lift overflow-hidden px-10 pb-[52px] pt-14 text-center max-md:px-[22px] max-md:pb-10 max-md:pt-9">
    <div class="mx-auto max-w-[620px]">
      <Thread variant="lemniscate" primary={verified} secondary={frontier} class="hero-thread mx-auto mb-2" />

      <h1 class="font-display text-[38px] font-extrabold tracking-[-.015em] max-md:text-[26px]">
        the<span class="text-thread">infinity</span>.ai
      </h1>

      <p class="mx-auto mb-[30px] mt-2.5 max-w-[44ch] text-[15px] text-dust">
        {/*
          Not "every AI concept" any more. The graph is 57 nodes of attention,
          architecture and optimization — a real subfield, and nowhere near
          every concept in AI (#128). The old line sold BREADTH, which is the
          one thing it could not deliver; depth and connectedness are what it
          actually has, so that is what it now says. It should stay true as the
          graph grows rather than needing a rewrite per seed batch.
        */}
        AI concepts, connected at three depths. Start anywhere — the map never ends.
      </p>

      <!--
        The one glow on this screen. Nothing else here carries a shadow.

        A real GET form, and that is the point: with no JavaScript it
        navigates to /search, which answers the query there. The overlay is the
        better experience and the form is what makes the URL bookmarkable.

        WHY THIS BOX DOES NOT TYPE AHEAD — ADR-0023. Two QA passes have filed
        the difference between this form and the header's island as a defect.
        It is a decision: the island costs 64 KB gzipped, almost all of it the
        React floor, on the one page budgeted at zero. The ADR carries the
        measurement and the condition for reopening it.
      -->
      <form
        role="search"
        action="/search"
        method="get"
        class="mx-auto flex max-w-[540px] overflow-hidden rounded-island border border-thread bg-void shadow-thread focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-thread"
      >
        <label for="q" class="sr-only">Search concepts</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Start anywhere — try &ldquo;attention&rdquo; or &ldquo;flow matching&rdquo;"
          class="min-w-0 flex-1 bg-transparent px-[18px] py-4 text-[15px] text-starlight outline-none placeholder:text-dust"
        />
        <button type="submit" class="cursor-pointer border-0 bg-thread px-6 text-[14px] font-bold text-void">
          <span class="max-md:hidden">Explore</span><span class="md:hidden">Go</span>
        </button>
      </form>

      <div class="my-[26px] flex flex-wrap justify-center gap-2.5">
        {
          chips.map((node, i) => (
            <a
              href={`/c/${node.id}`}
              class:list={[
                'rounded-pill border border-line bg-nebula-2 px-[15px] py-[7px] text-[13px] text-starlight no-underline hover:border-thread',
                i >= 4 ? 'max-md:hidden' : '',
              ]}
            >
              {node.title}
            </a>
          ))
        }
      </div>

      {/*
        The count was already here; it is now the way in. This route has no nav
        bar by design — "no CTA beyond search" — and adding one would be a
        second competing invitation next to the single glowing field. Making a
        sentence that already exists clickable is not a nav bar, and without it
        the only path to the index from here is submitting the form (#107).
      */}
      <p class="font-mono text-[12px] text-dust">
        <a href="/concepts" class="text-dust underline decoration-line underline-offset-4 hover:text-starlight hover:decoration-thread">
          {concepts.toLocaleString()} concepts
        </a> &middot;{' '}
        {
          /*
            THREE STATES, AND THE FIRST DRAFT OF THIS GOT THEM WRONG (ADR-0015).
            "0 grew on the frontier this week" is true and says nothing worth
            saying, and it spends the teal — the colour that means new growth —
            on the absence of it.

            But `grewThisWeek` counts frontier nodes touched in the last SEVEN
            DAYS, which is narrower than the frontier existing: it reads zero
            today while three concepts are awaiting review. Swapping on it would
            have claimed "every concept reviewed" while three were not. The
            claim belongs to `frontier === 0`, which is the condition that makes
            it true.
          */
          awaitingReview === 0 ? (
            <b class="font-semibold text-verified">every concept reviewed</b>
          ) : grewThisWeek > 0 ? (
            <b class="font-semibold text-frontier">{grewThisWeek} grew on the frontier this week</b>
          ) : (
            <b class="font-semibold text-frontier">{awaitingReview} on the frontier</b>
          )
        }
      </p>

      {/*
        THE LEDE ABOVE ALREADY CLAIMS "connected at three depths" AND NOTHING ON
        THIS PAGE ACTED ON IT (#508). The toggle is mounted on `/c/[id]` and
        nowhere else, so a reader arriving as a mathematician met a paragraph
        written for a stranger with no sign that a Math body existed underneath.

        Three anchors, and deliberately not a control. A chooser here would ask
        someone to pick between three words before they have seen what any of
        them does to a page; showing one real concept at each depth demonstrates
        the idea instead of quizzing them on it. It is also why this is not a
        second CTA: it sits in the quietest type on the screen, in the same mono
        register as the count above it, and the glow stays on the search field
        alone — the two rules this route's own comments set.

        These links work because the toggle ADOPTS a linked depth as the ongoing
        preference (#42), so choosing Math here means Math on the next concept
        too. `hrefFor` leaves Intuition unmarked, so the default link is the
        ordinary `/c/<id>` a reader would otherwise get.

        WITHOUT JAVASCRIPT THE PARAMETER IS INERT: the page is static, all three
        bodies ship in its HTML, and it is the island that swaps them. A no-JS
        reader follows these links to the intuition body — the same thing they
        would have got from the chip above, so nothing is lost, and nothing here
        pretends otherwise.
      */}
      {sample && (
        <p class="mt-2 font-mono text-[12px] text-dust">
          {/*
            The title as authored, not lower-cased. The concept is derived from
            the layout file, so this has to hold for whatever it names next —
            and `"lora"` or `"kv cache"` is a worse sentence than the capitals
            the node itself carries.
          */}
          new here? read {sample.title} at{' '}
          {DEPTHS.map((depth, i) => (
            <>
              {i > 0 && <span class="px-1 text-line">&middot;</span>}
              <a
                href={hrefFor(sample.id, depth)}
                class="text-[11px] uppercase tracking-[.16em] text-dust underline decoration-line underline-offset-4 hover:text-starlight hover:decoration-thread"
              >
                {LABEL[depth]}
              </a>
            </>
          ))}
        </p>
      )}
    </div>
  </main>
</Base>
