---
// Route 1 — Universe. Job: orient and invite; get the visitor onto a node in
// under ten seconds. No nav bar, no CTA beyond search. The search field is the
// one glowing element on this screen.
import Base from '../layouts/Base.astro';
import Thread from '../components/Thread.astro';
import { allNodes, stats } from '../lib/content';
import type { Tier } from '../lib/graph';

const { concepts, grewThisWeek } = stats();

// Lemniscate bead positions are a committed static layout (ADR-0003) — never a
// force simulation at load. Verified nodes take the left lobe, frontier the
// right, so the figure reads as "reviewed core → new growth".
const LEFT = [
  { x: 145, y: 72 },
  { x: 104, y: 115 },
  { x: 145, y: 158 },
];
const RIGHT = [
  { x: 475, y: 72 },
  { x: 516, y: 115 },
  { x: 475, y: 158 },
];

const verified = allNodes.filter((n) => n.tier === 'verified');
const frontier = allNodes.filter((n) => n.tier === 'frontier');

const beads = [
  ...verified.slice(0, 3).map((n, i) => ({ ...LEFT[i]!, tier: 'verified' as Tier, label: n.id })),
  ...frontier.slice(0, 3).map((n, i) => ({ ...RIGHT[i]!, tier: 'frontier' as Tier, label: n.id })),
];

const chips = allNodes.slice(0, 6);
---

<Base
  title="theinfinity.ai — every AI concept, connected"
  description="An infinitely explorable concept graph for AI/ML. Start anywhere — the map never ends."
>
  <main class="hero-lift overflow-hidden px-10 pb-[52px] pt-14 text-center max-md:px-[22px] max-md:pb-10 max-md:pt-9">
    <div class="mx-auto max-w-[620px]">
      <Thread variant="lemniscate" beads={beads} class="mx-auto mb-2" />

      <h1 class="font-display text-[38px] font-extrabold tracking-[-.015em] max-md:text-[26px]">
        the<span class="text-thread">infinity</span>.ai
      </h1>

      <p class="mx-auto mb-[30px] mt-2.5 max-w-[44ch] text-[15px] text-dust">
        Every AI concept, connected. Start anywhere — the map never ends.
      </p>

      <!-- The one glow on this screen. Nothing else here carries a shadow. -->
      <form
        role="search"
        action="/search"
        method="get"
        class="mx-auto flex max-w-[540px] overflow-hidden rounded-island border border-thread bg-void shadow-thread"
      >
        <label for="q" class="sr-only">Search concepts</label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Start anywhere — try &ldquo;attention&rdquo; or &ldquo;flow matching&rdquo;"
          class="min-w-0 flex-1 bg-transparent px-[18px] py-4 text-[15px] text-starlight outline-none placeholder:text-dust"
        />
        <button type="submit" class="cursor-pointer border-0 bg-thread px-6 text-[14px] font-bold text-void">
          <span class="max-md:hidden">Explore</span><span class="md:hidden">Go</span>
        </button>
      </form>

      <div class="my-[26px] flex flex-wrap justify-center gap-2.5">
        {
          chips.map((node, i) => (
            <a
              href={`/c/${node.id}`}
              class:list={[
                'rounded-pill border border-line bg-nebula-2 px-[15px] py-[7px] text-[13px] text-starlight no-underline hover:border-thread',
                i >= 4 ? 'max-md:hidden' : '',
              ]}
            >
              {node.title}
            </a>
          ))
        }
      </div>

      <p class="font-mono text-[12px] text-dust">
        {concepts.toLocaleString()} concepts ·
        <b class="font-semibold text-frontier">{grewThisWeek} grew on the frontier this week</b>
      </p>
    </div>
  </main>
</Base>
